# Copy this file to .env and fill in your own values. Never commit .env
# (it's in .gitignore). On a host like Render, set these in its settings
# instead. Lines starting with "# NAME=" are optional; remove the "# " to
# change the default shown.

# Discord
# Bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Discord user IDs allowed to use admin commands, separated by commas.
ADMIN_IDS=123456789012345678,987654321098765432

# Channels (required): reminders, the pick'em games, and admin warnings.
REMINDER_CHANNEL_ID=
GAME_CHANNEL_ID=
ADMIN_CHANNEL_ID=

# Name of the weekly pick'em game in the bot's messages.
# GAME_NAME=Weekly Pick'em

# Name of the fantasy league, e.g. in the season-end standings banner.
# LEAGUE_NAME=The League

# Timezone for all reminders and dates, e.g. America/New_York. Full list:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
LEAGUE_TIMEZONE=Europe/Oslo

# Google Sheets
# Path to the service account key file.
GOOGLE_SHEETS_KEYFILE=credentials.json

# Names of your pick'em spreadsheet and your league (PPR) spreadsheet. The
# bot finds them by name, so each must be unique among the sheets shared
# with the service account.
# PICKEM_SHEET_NAME=Pick'em
# LEAGUE_SHEET_NAME=League

# Labels the bot writes into the pick'em sheet and searches for later. If
# your sheet already uses other labels, match them exactly, or season totals
# restart from zero.
# WEEKLY_POINTS_SHEET_LABEL=Weekly points
# SEASON_TOTAL_SHEET_LABEL=Season total
# DRAW_SHEET_LABEL=Tie

# ESPN fantasy league (ESPN_S2 and ESPN_SWID are only needed for private leagues)
ESPN_LEAGUE_ID=
ESPN_YEAR=2026
ESPN_S2=
ESPN_SWID=

# Last week of your ESPN fantasy season, playoffs included (check your
# league's ESPN settings). The weekly digest stops after it.
# FANTASY_FINAL_WEEK=17

# PPR (required for !ppr): each manager's tab in the league sheet, then "="
# and the team name to show, separated by ";". Without "=team name", the
# tab name is shown.
PPR_MANAGERS=John C=The Gridiron Gang;John A=Fourth and Long;Michael=End Zone Express

# Tab in the league sheet for PPR snapshots.
# PPR_HISTORY_SHEET_NAME=PPR History

# Message text: everything the bot posts, e.g. to translate it. Keep every
# {placeholder} exactly as shown (including formatting like {score:.2f}),
# and write line breaks as \n.
#
# Command errors (core/bot.py):
# PERMISSION_DENIED_MESSAGE=Maybe if you ask nicely enough, you'll be allowed to use the bot.
# COMMAND_USAGE_MESSAGE=Couldn't read that. Usage: `{usage}`
#
# Pick'em game (cogs/pickem.py):
# GAMES_POSTED_MESSAGE=@everyone This week's games are posted in <#{channel}>!
# WEEKLY_GAMES_POSTED_MESSAGE=@everyone This week's games (week {week}) are posted in <#{channel}>!
# THURSDAY_GAME_REMINDER_MESSAGE=@everyone Heads up, the week is starting soon, check <#{channel}>!
# SUNDAY_GAME_REMINDER_MESSAGE=@everyone Early window starting soon, don't forget <#{channel}>
# PICK_INSTRUCTIONS_MESSAGE=React with the team you think will win on the messages above.
# EXPORT_SUCCESS_MESSAGE=Game data exported to Sheets.
# EXPORT_NO_DATA_MESSAGE=No values to update
# CURRENT_WEEK_LABEL=current
# RESULTS_HEADER_TEMPLATE=Points for week {week}:
# SEASON_TOTAL_LABEL=Season total:
# RESULTS_UPDATED_MESSAGE=✅ Results for week {week} updated.
#
# PPR (cogs/ppr.py):
# PPR_NO_DATA_MESSAGE=@everyone, this week's PPR update: No data available.
# PPR_UPDATE_MESSAGE=@everyone, this week's PPR update:\n```\n{rankings}\n```
#
# Fantasy reminders (cogs/fantasy_reminders.py):
# WAIVER_REMINDER_MESSAGE=@everyone Don't forget waivers!
# DIGEST_FAILURE_MESSAGE=Could not generate matchup digest this week.
# COOLDOWN_MESSAGE_TEMPLATE={user} tried again too soon! Please wait {seconds:.1f} more seconds.
#
# Weekly matchup digest labels (same message, built from many small pieces):
# RECAP_HEADER_TEMPLATE=**Weekly recap (Week {week}):**
# NO_GAMES_RECAP_LABEL=- No games to recap.
# AWARDS_HEADER_LABEL=**Weekly awards:**
# NAILBITER_LABEL=Nail-biter
# TOP_SCORER_LABEL=Top scorer
# LOWEST_SCORER_LABEL=Lowest scorer
# BENCH_AWARD_LABEL=Best bench
# OVERACHIEVER_LABEL=Overachiever
# UNDERACHIEVER_LABEL=Underachiever
# SCORE_SUMMARY_TEMPLATE={team} with {score:.2f} points
# BENCH_SUMMARY_TEMPLATE={team} with {score:.2f} points on the bench
# OVERACHIEVER_SUMMARY_TEMPLATE={team} overachieved by {diff:.2f} vs. proj.
# UNDERACHIEVER_SUMMARY_TEMPLATE={team} underachieved by {diff:.2f} vs. proj.
# WIN_STREAKS_HEADER_LABEL=**Win streaks (3+):**
# LOSS_STREAKS_HEADER_LABEL=**Loss streaks (3+):**
# NO_STREAKS_LABEL=- None
# WIN_STREAK_LINE_TEMPLATE={name}: {run} wins in a row
# LOSS_STREAK_LINE_TEMPLATE={name}: {run} losses in a row
# STANDINGS_LINE_TEMPLATE={medal}{rank}. {team}: {wins}-{losses} ({points:.2f} points)
# FINAL_STANDINGS_BANNER_TEMPLATE=**{league_name} {year}**
# SEASON_END_MESSAGE=Thanks for the season! 🎉
# PREVIEW_HEADER_TEMPLATE=**Next week's games (Week {week}):**
#
# Inactive-player alerts:
# INACTIVE_ALERT_HEADER_TEMPLATE=<@{user}>: You have inactive players in your lineup!
# INACTIVE_PLAYER_LINE_TEMPLATE=- {name} ({status}) starts around {time}
# INACTIVE_PLAYER_LINE_WITH_TEAM_TEMPLATE=- {team}: {name} ({status}) starts around {time}
# SOON_LABEL=soon
# INACTIVE_FALLBACK_HEADER=@everyone Someone has inactive players in their active lineup:

# Other files the bot reads (on Render, upload them as Secret Files):
# credentials.json      Google service account key (see GOOGLE_SHEETS_KEYFILE)
# discord_ids.json      which Discord user owns which ESPN team:
#                       {"espn_team_id": "discord_user_id", ...}
# custom_commands.json - optional, your own text commands, format:
#                      {"command_name": "reply text", ...}
#                      (see custom_commands.example.json)
